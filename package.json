{
  "name": "neo4j-better-auth",
  "version": "0.2.0",
  "description": "Better Auth database adapter for Neo4j (nodes + relationship edges for foreign keys)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish --provenance",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "better-auth",
    "neo4j",
    "cypher",
    "authentication",
    "adapter"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florianamette/neo4j-better-auth.git"
  },
  "bugs": {
    "url": "https://github.com/florianamette/neo4j-better-auth/issues"
  },
  "homepage": "https://github.com/florianamette/neo4j-better-auth#readme",
  "peerDependencies": {
    "@neo4j/cypher-builder": "^3.0.1",
    "better-auth": "^1.6.2",
    "neo4j-driver": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@better-auth/test-utils": "^1.7.20",
    "@changesets/cli": "^3.0.3",
    "@neo4j/cypher-builder": "^3.3.0",
    "@testcontainers/neo4j": "^12.2.1",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.20",
    "neo4j-driver": "^6.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "@protobufjs/utf8@<1.1.1": "^1.1.1",
      "brace-expansion@2": "^2.1.2",
      "defu@<6.1.5": "^6.1.5",
      "glob@<14.0.2": "^14.0.2",
      "lodash@<4.18.0": "^4.18.0",
      "minimatch@<11.0.1": "^11.0.1",
      "nanoid@3": "^3.3.16",
      "postcss@<8.5.10": "^8.5.10",
      "protobufjs@<7.5.6": "^7.5.6",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
